{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "mythictatics-web",
  // Built by `nx build web`; paths are relative to this file.
  "main": "../../dist/apps/web/server/server.mjs",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    // Prerendered HTML, JS and CSS are served directly and never invoke the Worker.
    "directory": "../../dist/apps/web/browser",
    "binding": "ASSETS",
    "not_found_handling": "none",
    // Prerendering writes `comps/index.html`; serve it at `/comps`, the URL every link and every
    // canonical tag uses, rather than redirecting `/comps` to `/comps/`.
    "html_handling": "drop-trailing-slash",
  },
  "observability": { "enabled": true },
  // Custom domain: the zone `mythictatics.click` must exist on the Cloudflare account before the
  // next deploy, or `wrangler deploy` fails — see docs/deploy-cloudflare.md §6.
  "routes": [
    { "pattern": "mythictatics.click", "custom_domain": true },
    { "pattern": "www.mythictatics.click", "custom_domain": true },
  ],
}
