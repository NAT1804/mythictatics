{
  "$schema": "../../node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.csr.html",
  "navigationRequestStrategy": "freshness",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/index.csr.html",
          "/favicon.ico",
          "/manifest.webmanifest",
          "/brand/icon-192.png",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "dataset",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/data/canonical/*.json"]
      }
    },
    {
      "name": "media",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "files": ["/media/**", "/brand/**", "/images/**"]
      }
    }
  ]
}
